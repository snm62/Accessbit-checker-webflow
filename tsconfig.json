{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["@webflow/designer-extension-typings"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "public"]
}
